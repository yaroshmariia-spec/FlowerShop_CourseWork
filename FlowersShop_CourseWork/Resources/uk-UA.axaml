    <system:String x:Key="LogAnalysisPerformed">Користувач {0} провів аналіз списання. Списано: {1} шт.</system:String>
    <system:String x:Key="Analysis">Інтелектуальний аналіз складу</system:String>
    <system:String x:Key="AlgorithmAnalysis">Алгоритм проаналізує залишки, виявить зіпсовані/прострочені квіти, спише їх та згенерує звіт.</system:String>
    <system:String x:Key="SmartAnalysis">Провести смарт-аналіз та списання</system:String>
    <system:String x:Key="HistoryOffs">Історія списань</system:String>
    <system:String x:Key="MakeOrder">Оформити замовлення</system:String>
    <system:String x:Key="OrderSearching">Пошук за назвою...</system:String>
    <system:String x:Key="OrderHIT">ХІТ</system:String>
   
</ResourceDictionary>
